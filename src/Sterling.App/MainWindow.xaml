<Window x:Class="Sterling.App.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Sterling Software Centre" Width="1380" Height="960" MinWidth="1000" MinHeight="800" Icon="Branding/SterlingSoftwareCentre.ico" Background="#EFF4F8" FontFamily="Segoe UI" FontSize="14">

 <DockPanel Background="#EFF4F8">
  <Border DockPanel.Dock="Top" Background="#102D46" Padding="26,18">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel><StackPanel Orientation="Horizontal"><Image Source="{StaticResource Icon.app}" Width="42" Height="42" Margin="0,0,14,0"/><StackPanel><TextBlock Text="STERLING TECH" Foreground="#3DE0C3" FontSize="11" FontWeight="Bold"/><TextBlock Text="Software Centre" Foreground="White" FontSize="25" FontWeight="SemiBold"/></StackPanel></StackPanel><TextBlock x:Name="Subtitle" Foreground="#B8CCE4" Margin="0,7,0,0"/></StackPanel>
    <TextBlock x:Name="VersionLabel" Grid.Column="1" Foreground="White" VerticalAlignment="Center"/>
   </Grid>
  </Border>
  <Border DockPanel.Dock="Bottom" Background="#E2EAF3" Padding="20,10"><TextBlock x:Name="StatusText" Text="Ready" TextWrapping="Wrap"/></Border>
  <TabControl x:Name="Tabs" Margin="20" Background="White">
   <TabItem><TabItem.Header><StackPanel Orientation="Horizontal"><Image Source="{StaticResource Icon.install}" Style="{StaticResource ActionIcon}"/><TextBlock Text="Find &amp; deploy"/></StackPanel></TabItem.Header>
    <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="180"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <TextBlock Style="{StaticResource Note}" Text="Search approved sources and tick packages. Your selection stays here across searches. Review scope and version before starting."/>
     <DockPanel Grid.Row="1">
      <Button DockPanel.Dock="Right" Content="Search" Click="Search_Click"/>
      <ComboBox x:Name="ProviderBox" DockPanel.Dock="Left" Width="150" SelectedIndex="0"><ComboBoxItem Content="winget"/><ComboBoxItem Content="chocolatey"/></ComboBox>
      <TextBox x:Name="SearchBox" KeyDown="Search_KeyDown" ToolTip="Search by name or exact package ID"/>
     </DockPanel>
     <DataGrid x:Name="SearchGrid" Grid.Row="2"><DataGrid.Columns>
      <DataGridTemplateColumn Header="Select" Width="60"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding Selected, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
      <DataGridTextColumn Header="Application" Binding="{Binding Name}" Width="*" IsReadOnly="True"/>
      <DataGridTextColumn Header="Exact package ID" Binding="{Binding Id}" Width="280" IsReadOnly="True"/>
      <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="140" IsReadOnly="True"/>
     </DataGrid.Columns></DataGrid><TextBlock Grid.Row="2" Text="Search for an application to see packages from the selected provider." HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Foreground="#526C7E" TextWrapping="Wrap" Margin="20"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Items.Count, ElementName=SearchGrid}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
     <TextBlock Grid.Row="3" Text="DEPLOYMENT SELECTION" FontWeight="SemiBold" Margin="0,16,0,8"/>
     <DataGrid x:Name="BasketGrid" Grid.Row="4"><DataGrid.Columns>
      <DataGridTextColumn Header="Provider" Binding="{Binding Provider}" IsReadOnly="True" Width="100"/>
      <DataGridTextColumn Header="Application / ID" Binding="{Binding Id}" IsReadOnly="True" Width="*"/>
      <DataGridComboBoxColumn Header="Scope" SelectedItemBinding="{Binding Scope, UpdateSourceTrigger=PropertyChanged}" x:Name="BasketScope" Width="115"/>
      <DataGridComboBoxColumn Header="Version policy" SelectedItemBinding="{Binding VersionPolicy, UpdateSourceTrigger=PropertyChanged}" x:Name="BasketPolicy" Width="135"/>
      <DataGridTextColumn Header="Exact version (Captured)" Binding="{Binding Version, UpdateSourceTrigger=PropertyChanged}" Width="190"/>
     </DataGrid.Columns></DataGrid><TextBlock Grid.Row="4" Text="Tick search results to build your deployment selection." HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Foreground="#526C7E" TextWrapping="Wrap" Margin="20"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Items.Count, ElementName=BasketGrid}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
     <WrapPanel Grid.Row="5" Margin="0,12,0,0">
      <Button Content="Review install selection" Click="Install_Click" Style="{StaticResource Primary}"/>
      <Button Content="Remove highlighted" Click="RemoveBasket_Click"/>
      <Button Content="Clear selection" Click="ClearBasket_Click"/>
      <Button Click="SaveList_Click"><StackPanel Orientation="Horizontal"><Image Source="{StaticResource Icon.lists}" Style="{StaticResource ActionIcon}"/><TextBlock Text="Save deployment list…"/></StackPanel></Button>
     </WrapPanel>
    </Grid>
   </TabItem>
   <TabItem><TabItem.Header><StackPanel Orientation="Horizontal"><Image Source="{StaticResource Icon.update}" Style="{StaticResource ActionIcon}"/><TextBlock Text="Installed &amp; updates"/></StackPanel></TabItem.Header>
    <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <TextBlock Style="{StaticResource Note}" Text="Provider match means the provider can currently manage this application; it does not prove how it was originally installed. Review unknown items and multiple instances manually."/>
     <WrapPanel Grid.Row="1">
      <Button Content="Refresh inventory" Click="Inventory_Click"/><Button Content="Tick all" Click="SelectInventory_Click"/><Button Content="Clear ticks" Click="ClearInventory_Click"/>
      <Button Click="Capture_Click"><StackPanel Orientation="Horizontal"><Image Source="{StaticResource Icon.capture}" Style="{StaticResource ActionIcon}"/><TextBlock Text="Capture this PC"/></StackPanel></Button><Button Content="Save ticked capture…" Click="SaveCapture_Click"/>
     </WrapPanel>
     <DataGrid x:Name="InventoryGrid" Grid.Row="2"><DataGrid.Columns>
      <DataGridTemplateColumn Header="Select" Width="55"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding Selected, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
      <DataGridTextColumn Header="Application" Binding="{Binding Name}" Width="*" IsReadOnly="True"/>
      <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="185" IsReadOnly="True"/>
      <DataGridTextColumn Header="Provider" Binding="{Binding Provider}" Width="90" IsReadOnly="True"/>
      <DataGridTextColumn Header="Installed" Binding="{Binding Version}" Width="110" IsReadOnly="True"/>
      <DataGridTextColumn Header="Available" Binding="{Binding Available}" Width="110" IsReadOnly="True"/>
      <DataGridTextColumn Header="Scope" Binding="{Binding Scope}" Width="80" IsReadOnly="True"/>
      <DataGridTextColumn Header="Review / policy" Binding="{Binding State}" Width="190" IsReadOnly="True"/>
     </DataGrid.Columns></DataGrid><TextBlock Grid.Row="2" Text="Refresh inventory to view installed software and available updates." HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Foreground="#526C7E" TextWrapping="Wrap" Margin="20"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Items.Count, ElementName=InventoryGrid}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
     <WrapPanel Grid.Row="3" Margin="0,12,0,0">
      <Button Content="Update ticked" Click="UpdateSelected_Click"/><Button Content="Update all eligible" Click="UpdateAll_Click"/>
      <Button Click="Uninstall_Click"><StackPanel Orientation="Horizontal"><Image Source="{StaticResource Icon.uninstall}" Style="{StaticResource ActionIcon}"/><TextBlock Text="Uninstall ticked…"/></StackPanel></Button><Button Content="Exclude ticked" Click="Exclude_Click"/><Button Content="Remove exclusions" Click="Unexclude_Click"/>
     </WrapPanel>
    </Grid>
   </TabItem>
   <TabItem><TabItem.Header><StackPanel Orientation="Horizontal"><Image Source="{StaticResource Icon.restore}" Style="{StaticResource ActionIcon}"/><TextBlock Text="Capture &amp; Restore"/></StackPanel></TabItem.Header>
    <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel><TextBlock x:Name="BundleLabel" Text="Your recovery workspace" Style="{StaticResource Heading}"/><TextBlock Style="{StaticResource Note}" Text="Open a capture or deployment list, or capture this PC. Tick several apps for bulk restore; highlight one to configure its version and data options below. Unsupported data stays manual."/></StackPanel>
     <WrapPanel Grid.Row="1">
      <Button Content="Open bundle / list…" Click="OpenBundle_Click"/><Button Click="Capture_Click"><StackPanel Orientation="Horizontal"><Image Source="{StaticResource Icon.capture}" Style="{StaticResource ActionIcon}"/><TextBlock Text="Capture this PC"/></StackPanel></Button><Button Content="Standard workstation" Click="Preset_Click"/>
      <Button Content="Tick ready items" Click="SelectRestore_Click"/><Button Content="Use captured versions" Click="CapturedPolicy_Click"/><Button Content="Use newest versions" Click="NewestPolicy_Click"/>
     </WrapPanel>
     <DataGrid x:Name="RestoreGrid" Grid.Row="2" SelectionChanged="RestoreSelection_Changed"><DataGrid.Columns>
      <DataGridTemplateColumn Header="Select" Width="55"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding Selected, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
      <DataGridTextColumn Header="Application" Binding="{Binding Name}" Width="*" IsReadOnly="True"/>
      <DataGridTextColumn Header="Provider / ID" Binding="{Binding Key}" Width="240" IsReadOnly="True"/>
      <DataGridTextColumn Header="Captured version" Binding="{Binding Version}" Width="125" IsReadOnly="True"/>
      <DataGridComboBoxColumn x:Name="RestoreScope" Header="Scope" SelectedItemBinding="{Binding Scope, UpdateSourceTrigger=PropertyChanged}" Width="105"/>
      <DataGridComboBoxColumn x:Name="RestorePolicy" Header="Policy" SelectedItemBinding="{Binding VersionPolicy, UpdateSourceTrigger=PropertyChanged}" Width="105"/>
      <DataGridTextColumn Header="Readiness" Binding="{Binding Disposition}" Width="210" IsReadOnly="True"/>
     </DataGrid.Columns></DataGrid><TextBlock Grid.Row="2" Text="Open a capture or choose Capture this PC to begin." HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Foreground="#526C7E" TextWrapping="Wrap" Margin="20"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Items.Count, ElementName=RestoreGrid}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
     <WrapPanel Grid.Row="3" Margin="0,12,0,0"><Button Content="Review bulk restore" Click="ReviewRestore_Click" Style="{StaticResource Primary}"/><Button Content="Check availability" Click="Availability_Click"/><Button Content="Add to deployment" Click="RestoreQueue_Click"/><Button Content="Save ticked capture…" Click="SaveCapture_Click"/><Button Click="RestoreUninstall_Click"><StackPanel Orientation="Horizontal"><Image Source="{StaticResource Icon.uninstall}" Style="{StaticResource ActionIcon}"/><TextBlock Text="Uninstall ticked…"/></StackPanel></Button><Button Content="Replace with captured…" Click="Replace_Click"/></WrapPanel>
     <Border Grid.Row="4" Background="#F0F8F8" BorderBrush="#C3E3DE" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,8,0,0">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="1.25*"/></Grid.ColumnDefinitions>
       <StackPanel Margin="0,0,18,0"><TextBlock x:Name="DataAppTitle" Text="Select an application for its details" FontSize="18" FontWeight="SemiBold" Foreground="#153B53"/><TextBlock x:Name="DataAppSummary" Style="{StaticResource Note}" Margin="0,6,0,10" Text="Software and application data are separate choices. No data recipe is selected by default."/>
        <StackPanel Orientation="Horizontal"><TextBlock Text="Install policy" VerticalAlignment="Center" Margin="0,0,10,8"/><ComboBox x:Name="DetailPolicy" Width="160" SelectedItem="{Binding VersionPolicy, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
        <TextBlock x:Name="DataRecipeStatus" Text="No application selected." TextWrapping="Wrap" Foreground="#526C7E"/>
       </StackPanel>
       <StackPanel Grid.Column="1" x:Name="DataRecipePanel" IsEnabled="False">
        <StackPanel Orientation="Horizontal"><Image Source="{StaticResource Icon.data}" Style="{StaticResource ActionIcon}"/><TextBlock Text="Chrome bookmarks · reviewed recipe" FontWeight="SemiBold"/><TextBlock Text="  · current Windows user" Foreground="#526C7E"/></StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0"><TextBlock Text="Profile" VerticalAlignment="Center" Margin="0,0,8,8"/><ComboBox x:Name="DataProfileBox" Width="150" IsEditable="False" SelectedItem="{Binding Data.ChromeProfile, UpdateSourceTrigger=PropertyChanged}" SelectionChanged="Profile_Changed"/><Button Content="Back up bookmarks…" Click="BackupBookmarks_Click"/><Button Content="Choose backup…" Click="ChooseBookmarks_Click"/></StackPanel>
        <CheckBox x:Name="RestoreDataBox" Content="Restore these bookmarks after software installation" IsChecked="{Binding Data.RestoreBookmarks, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
        <TextBlock x:Name="DataLocations" TextWrapping="Wrap" FontSize="12" Foreground="#426175"/>
        <Button Content="Review data restore only" Click="ReviewData_Click" HorizontalAlignment="Left" Margin="0,8,0,0"/>
       </StackPanel>
      </Grid>
     </Border>
    </Grid>
   </TabItem>
   <TabItem><TabItem.Header><StackPanel Orientation="Horizontal"><Image Source="{StaticResource Icon.lists}" Style="{StaticResource ActionIcon}"/><TextBlock Text="Jobs &amp; logs"/></StackPanel></TabItem.Header>
    <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="220"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <DockPanel Background="#EFF4F8"><StackPanel DockPanel.Dock="Right" Width="250"><TextBlock x:Name="JobProgressLabel" Text="No active job" Foreground="#476276"/><ProgressBar x:Name="JobProgress" Height="7" Maximum="100" Foreground="#087F83" Background="#E1EEF1" Margin="0,6,0,8"/></StackPanel><WrapPanel><Button Content="Retry failed items" Click="Retry_Click"/><Button Content="Stop after current package" Click="Stop_Click"/><Button Content="Open log folder" Click="Logs_Click"/></WrapPanel></DockPanel>
     <DataGrid x:Name="JobsGrid" Grid.Row="1" IsReadOnly="True"><DataGrid.Columns>
      <DataGridTextColumn Header="Package" Binding="{Binding Package.Id}" Width="230"/><DataGridTextColumn Header="Operation" Binding="{Binding Operation}" Width="110"/><DataGridTemplateColumn Header="Status" Width="130"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border Style="{StaticResource StatusBadge}"><StackPanel Orientation="Horizontal"><Image Width="16" Height="16" Margin="0,0,6,0"><Image.Style><Style TargetType="Image"><Setter Property="Source" Value="{StaticResource Icon.warning}"/><Style.Triggers><DataTrigger Binding="{Binding Status}" Value="Succeeded"><Setter Property="Source" Value="{StaticResource Icon.success}"/></DataTrigger><DataTrigger Binding="{Binding Status}" Value="Failed"><Setter Property="Source" Value="{StaticResource Icon.failure}"/></DataTrigger></Style.Triggers></Style></Image.Style></Image><TextBlock Text="{Binding Status}" Foreground="#244F58"/></StackPanel></Border></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridCheckBoxColumn Header="Restart" Binding="{Binding RestartRequired}" Width="65"/><DataGridTextColumn Header="Result" Binding="{Binding Detail}" Width="*"/>
     </DataGrid.Columns></DataGrid><TextBlock Grid.Row="1" Text="No jobs yet. Review a selection and choose Start." HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Foreground="#526C7E" TextWrapping="Wrap" Margin="20"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Items.Count, ElementName=JobsGrid}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
     <TextBlock Grid.Row="2" Text="OPERATION LOG" FontWeight="SemiBold" Margin="0,16,0,8"/>
     <TextBox x:Name="LogBox" Grid.Row="3" IsReadOnly="True" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="#11243A" Foreground="#D3E3F5" Margin="0"/>
    </Grid>
   </TabItem>
   <TabItem><TabItem.Header><StackPanel Orientation="Horizontal"><Image Source="{StaticResource Icon.settings}" Style="{StaticResource ActionIcon}"/><TextBlock Text="Settings &amp; help"/></StackPanel></TabItem.Header>
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="22" MaxWidth="950" HorizontalAlignment="Left">
     <TextBlock Text="Package providers" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,12"/>
     <TextBlock x:Name="ProvidersStatus" Style="{StaticResource Note}"/>
     <WrapPanel><Button Content="Detect providers" Click="Detect_Click"/><Button Content="WinGet setup guide" Click="WingetHelp_Click"/><Button Content="Chocolatey organisation guide" Click="ChocoHelp_Click"/></WrapPanel>
     <TextBlock Text="Chocolatey internal/customer HTTPS repository" Margin="0,12,0,6"/>
     <TextBox x:Name="ChocoSourceBox" MinWidth="600"/>
     <TextBlock Style="{StaticResource Note}" Text="No package manager is installed automatically. Chocolatey requires an authorised repository and an administrator-managed installation. Public Community Repository deployment is blocked; ensure any proxy or cache is licensed and compliant."/>
     <CheckBox x:Name="AgreementBox" Content="I have reviewed and accept the WinGet source agreements for this PC" Margin="0,4,0,12"/>
     <CheckBox x:Name="AppUpdateBox" Content="Check GitHub for Sterling updates when the application opens (notify only)" Margin="0,0,0,12"/>
     <Button Content="Save settings" Click="Settings_Click" HorizontalAlignment="Left"/>
     <Separator Margin="0,12"/>
     <TextBlock Text="Sterling application updates" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,12"/>
     <TextBlock x:Name="AppUpdateStatus" Style="{StaticResource Note}" Text="Check for new stable releases. Download and installation always require your confirmation."/>
     <WrapPanel><Button Content="Check for Sterling Software Centre updates" Click="CheckAppUpdate_Click"/><Button x:Name="ApplyUpdateButton" Content="Download and update…" Click="ApplyAppUpdate_Click" IsEnabled="False"/><Button Content="GitHub releases" Click="Releases_Click"/></WrapPanel>
     <TextBox x:Name="ReleaseNotesBox" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxHeight="260" MinHeight="90" Text="Release notes will appear here when an update is available." Background="#F4F8FB"/>
     <TextBlock Style="{StaticResource Note}" Text="The helper verifies SHA-256, closes Sterling, backs up the current binaries and applies the release. It restores changed files if copying fails. User settings and job logs remain in LocalAppData. Self-update is unavailable while elevated or inside protected/symlinked folders."/>
     <Separator Margin="0,12"/>
     <TextBlock Text="Release scope &amp; operating notes" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,12"/>
     <TextBlock Style="{StaticResource Note}" Text="This release manages the PC where it runs. Agent installation, controller enrolment, LAN push deployment, scheduled policies, generic registry imports and generic ordered deployment recipes are not available. No background service or network listener is installed. WinGet table parsing currently requires English output. Use one software policy owner per application; exclude applications controlled by NinjaOne. Run as the intended Windows user; package installers may request elevation. Capture bundles contain inventory, not installers or application licences."/>
     <Button Content="Open README" Click="Readme_Click" HorizontalAlignment="Left"/>
    </StackPanel></ScrollViewer>
   </TabItem>
   <TabItem x:Name="ReviewTab"><TabItem.Header><StackPanel Orientation="Horizontal"><Image Source="{StaticResource Icon.warning}" Style="{StaticResource ActionIcon}"/><TextBlock Text="Review"/></StackPanel></TabItem.Header>
    <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel><TextBlock x:Name="ReviewTitle" Text="Review before making changes" Style="{StaticResource Heading}"/><TextBlock x:Name="ReviewSummary" Text="Choose an install, update or restore action to prepare a review. Nothing runs until you choose Start." Style="{StaticResource Note}"/></StackPanel>
     <Border Grid.Row="1" Background="#FFF3DA" CornerRadius="8" Padding="14" Margin="0,0,0,16"><DockPanel><Image Source="{StaticResource Icon.warning}" Width="22" Height="22" Margin="0,0,12,0"/><TextBlock x:Name="ReviewWarning" Text="All changes are reviewed here in the main window. Windows may still show UAC prompts when an installer needs elevation." TextWrapping="Wrap" Foreground="#795118"/></DockPanel></Border>
     <DataGrid x:Name="ReviewGrid" MinRowHeight="42" Grid.Row="2" IsReadOnly="True" RowDetailsVisibilityMode="Visible"><DataGrid.Columns>
      <DataGridTextColumn ElementStyle="{StaticResource ReviewCell}" Header="Action" Binding="{Binding Action}" Width="150"/><DataGridTextColumn ElementStyle="{StaticResource ReviewCell}" Header="Application" Binding="{Binding Application}" Width="*"/><DataGridTextColumn ElementStyle="{StaticResource ReviewCell}" Header="Provider" Binding="{Binding Provider}" Width="85"/><DataGridTextColumn ElementStyle="{StaticResource ReviewCell}" Header="Exact ID" Binding="{Binding PackageId}" Width="190"/><DataGridTextColumn ElementStyle="{StaticResource ReviewCell}" Header="Installed" Binding="{Binding Installed}" Width="110"/><DataGridTextColumn ElementStyle="{StaticResource ReviewCell}" Header="Proposed" Binding="{Binding Proposed}" Width="170"/><DataGridTextColumn ElementStyle="{StaticResource ReviewCell}" Header="Scope" Binding="{Binding Scope}" Width="145"/>
     </DataGrid.Columns><DataGrid.RowDetailsTemplate><DataTemplate><Border Padding="12,4,12,12" Background="#F3F8FA"><TextBlock Text="{Binding Notes}" TextWrapping="Wrap" MaxWidth="1150" HorizontalAlignment="Left" Foreground="#4C6373" FontSize="12"/></Border></DataTemplate></DataGrid.RowDetailsTemplate></DataGrid>
     <CheckBox Grid.Row="3" x:Name="ReviewConsent" Content="I have reviewed every affected application, the licence terms and any data or activation impact." Margin="0,18,0,16" Checked="ReviewConsent_Changed" Unchecked="ReviewConsent_Changed"/>
     <WrapPanel Grid.Row="4"><Button x:Name="ReviewStartButton" Content="_Start" Style="{StaticResource Primary}" MinWidth="140" IsEnabled="False" Click="ReviewStart_Click"/><Button Content="_Back / Cancel" MinWidth="140" Click="ReviewCancel_Click"/></WrapPanel>
    </Grid>
   </TabItem>
  </TabControl>
 </DockPanel>
</Window>




